# Configuración de base de datos MySQL
# Formato: mysql+aiomysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL=mysql+aiomysql://root:admin@localhost/gym_manager

# PIN de seguridad para recuperar la contraseña del administrador
# Cambialo por uno que solo vos conozcas (mínimo 4 dígitos)
RECOVERY_PIN=1234
